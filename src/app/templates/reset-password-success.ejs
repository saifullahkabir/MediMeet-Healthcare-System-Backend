<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>MediMeet - Password Changed Successfully</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }

      .header {
        background-color: #0f766e;
        padding: 28px 24px;
        text-align: center;
      }

      .logo {
        margin: 0;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      .tagline {
        margin: 6px 0 0;
        color: #ccfbf1;
        font-size: 13px;
      }

      .content {
        padding: 40px 32px;
        text-align: center;
      }

      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background-color: #ccfbf1;
        color: #0f766e;
        font-size: 34px;
        line-height: 64px;
        font-weight: 700;
      }

      .title {
        margin: 0 0 14px;
        color: #111827;
        font-size: 24px;
        font-weight: 700;
      }

      .greeting {
        margin: 0 0 18px;
        color: #374151;
        font-size: 16px;
      }

      .message {
        max-width: 480px;
        margin: 0 auto;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.7;
      }

      .security-box {
        max-width: 480px;
        margin: 28px auto 0;
        padding: 16px;
        background-color: #f8fafc;
        border-left: 4px solid #0f766e;
        border-radius: 6px;
        text-align: left;
      }

      .security-box p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
      }

      .footer {
        padding: 22px 24px;
        text-align: center;
        background-color: #f8fafc;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 4px 0;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
      }

      .brand {
        color: #0f766e;
        font-weight: 600;
      }

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 32px 20px;
        }

        .header {
          padding: 24px 16px;
        }

        .logo {
          font-size: 24px;
        }

        .title {
          font-size: 21px;
        }

        .message {
          font-size: 14px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <!-- Header -->
        <div class="header">
          <h1 class="logo">MediMeet</h1>

          <p class="tagline">Online Healthcare &amp; Doctor Consultation</p>
        </div>

        <!-- Main Content -->
        <div class="content">
          <!-- Success Icon -->
          <div class="success-icon">✓</div>

          <h2 class="title">Password Changed Successfully</h2>

          <p class="greeting">Hello <strong><%= name %></strong>,</p>

          <p class="message">
            Your MediMeet account password has been successfully changed. You
            can now use your new password to securely log in to your account.
          </p>

          <!-- Security Notice -->
          <div class="security-box">
            <p>
              <strong>Security Notice:</strong>
              If you did not make this change, please contact the MediMeet
              support team immediately and secure your account.
            </p>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            This is an automated email from
            <span class="brand">MediMeet</span>.
          </p>

          <p>Please do not reply to this email.</p>

          <p>
            &copy; <%= new Date().getFullYear() %> MediMeet. All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
